# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# TMDB API configuration
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here

# Usage dashboard (optional)
# Leave unset and /admin/usage returns 404. Set it to enable the dashboard —
# SECRET_KEY must then be a real random value, since the dashboard login is a
# signed session cookie. Generate both with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SHOWTIME_ADMIN_TOKEN=

# Where aggregate usage counts are stored (defaults to ./metrics.db)
# METRICS_DB_PATH=metrics.db
